 #define AL_USE_RING_READ 0
+
+/*
+ * PC2 bring-up workaround: after a host process closes the h2c/c2h char
+ * devices, the engine can remain marked running even though the hardware
+ * descriptor chain has stopped. The next process then queues a transfer
+ * without restarting the engine and blocks until h2c_timeout. Stopping the
+ * engine on close clears ->running so the next transfer_queue() starts it.
+ * This assumes single-user access (the project's current host model).
+ */
+static bool reset_on_close = true;
+module_param(reset_on_close, bool, 0644);
+MODULE_PARM_DESC(reset_on_close,
+    "Stop/reset the SGDMA engine when a char device is closed (default 1)");
 
 extern struct kmem_cache *cdev_cache;
 
@@ -685,6 +700,32 @@
     case IOCTL_SGDMA_CUS_RW:
 	rv = ioctl_do_cus_dma(engine, arg);
 	break;
+    case ANLOGIC_IOCABORT: {
+        struct sgdma_transfer *xfer;
+        unsigned long flags;
+
+        spin_lock_irqsave(&engine->lock, flags);
+        if (list_empty(&engine->transfer_list)) {
+            rv = -ENOENT;
+        } else {
+            xfer = list_first_entry(&engine->transfer_list,
+                                    struct sgdma_transfer, entry);
+            pr_info("abort requested on %s xfer %p state %d\n",
+                    engine->name, xfer, xfer->state);
+            if (xfer->state == TRANSFER_STATE_SUBMITTED) {
+                xfer->state = TRANSFER_STATE_ABORTED;
+                list_del_init(&xfer->entry);
+                wake_up_interruptible(&xfer->wq);
+                rv = 0;
+            } else {
+                rv = -EALREADY;
+            }
+        }
+        spin_unlock_irqrestore(&engine->lock, flags);
+        if (rv == 0)
+            sgdma_engine_stop(engine);
+        break;
+    }
     default:
         dbg_perf("Unsupported operation\n");
         rv = -EINVAL;
@@ -729,6 +770,14 @@
 
     if (engine->streaming && engine->dir == DMA_FROM_DEVICE)
         engine->device_open = 0;
+
+    if (engine && reset_on_close) {
+        unsigned long flags;
+
+        spin_lock_irqsave(&engine->lock, flags);
+        sgdma_engine_stop(engine);
+        spin_unlock_irqrestore(&engine->lock, flags);
+    }
 
     return 0;
 }

