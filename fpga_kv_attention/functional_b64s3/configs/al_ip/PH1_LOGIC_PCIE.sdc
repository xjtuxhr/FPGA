create_clock -name core_clk -period 8 -waveform {0 1} [get_pins uep_PH1_PHY_PCIE.core_clk]
create_generated_clock  -name  pcie_user_clk -source  [get_pins uep_PH1_PHY_PCIE.core_clk ] -phase 0 -multiply_by 1 -duty_cycle 25  [get_pins {u_al_pcie_ip_ph1_clock_ctrl/u_al_pcie_ip_ph1_core_pll/pll_inst.clkc[0]}]
set_clock_latency 1.000 -clock [get_clocks {pcie_user_clk}]
set_false_path -from [get_pins {uep_PH1_PHY_PCIE.core_rst_n}]
set_false_path -from [get_pins {uep_PH1_PHY_PCIE.rdlh_link_up}]
set_false_path -from [get_regs {u_al_pcie_ip_ph1_dbi_init_mux/int_drp_dbi_done}]
set_false_path -from [get_regs {u_al_pcie_ip_ph1_dbi_init_mux/int_drp_dbi_state_dly[*]}]
set_false_path -from [get_regs {u_al_pcie_ip_ph1_clock_ctrl/ph1_pcie_cfg_st_aux[*]}]
set_false_path -from [get_regs {u_al_pcie_ip_ph1_clock_ctrl/user_link_aux}]
set_false_path -from [get_regs {u_al_pcie_ip_ph1_clock_ctrl/gen1_ready_aux_dly}]
set_false_path -from [get_regs {u_al_pcie_ip_ph1_clock_ctrl/lock_gen1_core}]
set_false_path -from [get_regs {u_al_pcie_ip_ph1_clock_ctrl/lock_gen2_core}]
set_false_path -from [get_regs {u_al_pcie_ip_ph1_clock_ctrl/lock_gen3_core}]
